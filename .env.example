# Database
DB_NAME=content_generator
DB_USER=content_generator
DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://content_generator:change-me@db:5432/content_generator

# Redis / object storage reserved for async jobs and generated assets
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-now

# Browser-accessible URL used for locally generated placeholder images
PUBLIC_BASE_URL=http://localhost:8000

# Text generation
# mock: local deterministic demo
# compatible: an OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
# Retry transient TLS, connection, timeout, and incomplete-response failures.
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_SECONDS=1

# OpenAI models share one API key and can be selected independently in the UI.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_LUNA_MODEL=gpt-5.6-luna

# Other providers used by the comparison flow.
# Fill only the values after "=". Never commit your real .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
# Token Plan rate limits count this cap: 16384 was refused outright (2062), 8192 is admitted.
MINIMAX_MAX_COMPLETION_TOKENS=8192
# Only for M3.x-Flash models, which always reason: low, medium, high, xhigh or max.
# Leave empty for medium; the API default can spend the whole output cap on reasoning.
# MiniMax-M3 itself runs with thinking disabled.
MINIMAX_REASONING_EFFORT=

# Kimi's official environment variable name is MOONSHOT_API_KEY.
MOONSHOT_API_KEY=
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# Image generation
# placeholder: local demo images
# compatible: an OpenAI-compatible /images/generations endpoint
# minimax: MiniMax image_generation endpoint (reuses MINIMAX_API_KEY)
IMAGE_PROVIDER=placeholder
# ai: all images use IMAGE_PROVIDER
# mixed: AI cover + alternating Wikimedia Commons inline images
# web: all images use WEB_IMAGE_PROVIDER
IMAGE_SOURCE_MODE=mixed
WEB_IMAGE_PROVIDER=openverse
DUCKDUCKGO_IMAGE_BASE_URL=https://duckduckgo.com
WEB_IMAGE_FALLBACK_TO_AI=true
OPENVERSE_API_URL=https://api.openverse.org/v1
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
# Add a contact URL or email before public production use.
WEB_IMAGE_USER_AGENT=ContentGenerator/0.1
WEB_IMAGE_MAX_BYTES=10485760
IMAGE_API_BASE=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT_SECONDS=120
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
# Set true if your publishing policy requires the MiniMax image watermark.
AIGC_WATERMARK=false

# WeChat Official Account
# Keep disabled until AppID, AppSecret and interface permissions are verified.
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=
WECHAT_API_BASE=https://api.weixin.qq.com

# Separate emotional-content account. Never falls back to the health account.
WECHAT_EMOTIONAL_ENABLED=false
WECHAT_EMOTIONAL_APP_ID=
WECHAT_EMOTIONAL_APP_SECRET=
WECHAT_EMOTIONAL_AUTHOR=

# Daily automation worker
# The plan's actual time and timezone are configured in the admin console.
AUTOMATION_POLL_SECONDS=30
AUTOMATION_MAX_RETRIES=3
AUTOMATION_STALE_MINUTES=120

# Backend-only still-image explainer video pipeline.
VIDEO_WORKER_POLL_SECONDS=5
VIDEO_MAX_RETRIES=3
VIDEO_STALE_MINUTES=30
VIDEO_DEFAULT_DURATION_SECONDS=90
VIDEO_DEFAULT_WIDTH=1280
VIDEO_DEFAULT_HEIGHT=720
VIDEO_DEFAULT_FPS=30
VIDEO_MAX_SOURCE_BYTES=2097152
VIDEO_SOURCE_TIMEOUT_SECONDS=15
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_FFPROBE_PATH=ffprobe
VIDEO_GENERATION_POLL_SECONDS=10
VIDEO_GENERATION_TIMEOUT_SECONDS=1200

# News/event research pipeline. DuckDuckGo works without a key; Tavily is optional.
NEWS_SEARCH_PROVIDER=duckduckgo
NEWS_SEARCH_TIMEOUT_SECONDS=20
NEWS_SEARCH_MAX_RESULTS=12
NEWS_MAX_DOCUMENTS=8
NEWS_MIN_INDEPENDENT_SOURCES=2
TAVILY_API_KEY=
# Default role routing; each video project can override these in the UI.
NEWS_MECHANICAL_PROVIDER=minimax
NEWS_JUDGMENT_PROVIDER=openai-terra
NEWS_RESEARCH_PROVIDER=openai
NEWS_WRITER_PROVIDER=minimax
NEWS_REVIEW_PROVIDER=openai-terra
# Independent LLM fact review is temporarily opt-in. Local claim-id validation remains enabled.
NEWS_REVIEW_ENABLED=false

# Use mock for local tests, or minimax with MINIMAX_API_KEY for real Chinese TTS.
SPEECH_PROVIDER=mock
SPEECH_MODEL=speech-2.8-hd
SPEECH_VOICE=male-qn-qingse
SPEECH_SPEED=1.0
SPEECH_TIMEOUT_SECONDS=120
